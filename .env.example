# Copy this file to .env.local for local development, and set the same
# values as environment variables in Hostinger's Node.js app settings for
# production. Never commit .env.local or real secrets to git.

# --- MySQL database (create one in Hostinger hPanel: Websites > your site >
# Databases > MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_flightsclub
DB_USER=u123456789_admin
DB_PASSWORD=change-me

# --- Admin panel (/admin) ---
# ADMIN_PASSWORD: the password used to log in at /admin/login. Choose
# something strong — this protects your ability to edit live site content.
ADMIN_PASSWORD=change-me

# ADMIN_SESSION_SECRET: a long random string used to sign admin login
# sessions. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Outgoing email (contact/quote/newsletter forms) ---
# Every form on the site (flight quote, holiday enquiry, visa enquiry,
# corporate travel, contact, newsletter) emails a notification to
# info@flightsclubuk.co.uk using this mailbox's own SMTP credentials — no
# third-party service (Resend/SendGrid/etc.) needed.
#
# Find these in Hostinger hPanel: Emails > info@flightsclubuk.co.uk >
# Connect Apps & Devices (or "Configure Email Client") > Manual Configuration.
# For Hostinger-hosted mailboxes these are typically:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
# SMTP_USER is the full mailbox address; SMTP_PASSWORD is that mailbox's
# password (not your hPanel account password).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@flightsclubuk.co.uk
SMTP_PASSWORD=change-me
